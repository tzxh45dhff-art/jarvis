# JARVIS configuration. Copy to `.env` (next to this file) and edit:
#
#     cp .env.example .env
#
# Every line is optional. A real environment variable beats .env, and .env beats
# the defaults. Settings (JARVIS_*) are read from <repo>/.env and ~/.jarvis/.env.
# API keys are read from the same files, or from ~/.jarvis/secrets.env (chmod 600),
# but are never exported into the environment of the commands JARVIS runs.
#
# NEVER commit your real .env: it is in .gitignore.

# ---------------------------------------------------------------- which model
# azure | gemini | claude | local.   Unset = the first one that is configured, in
# that order: Azure OpenAI, then Gemini, then the on-device model.
# One-off override from the shell:  jarvis --claude / --local / --cloud "task"
JARVIS_BACKEND=

# ------------------------------------------------------- Azure OpenAI (default)
# Sign-in is keyless: run `az login` once. No API key is used or stored. Your
# account needs the "Cognitive Services OpenAI User" role on the resource.
# (Alternatively write the same settings as JSON to ~/.jarvis/azure.json.)
JARVIS_AZURE_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# The main model: used for anything that acts (apps, files, documents, research).
JARVIS_AZURE_DEPLOYMENT=your-main-deployment

# Optional cheaper / stronger routes, by deployment name. Leave out to use the
# main model for everything. "off" switches a route off.
# - FAST: short single-step requests ("what's my battery?", unit conversions). Hands
#   over to the main model when a step fails or the request turns out harder.
# - WEB: plain web lookups ("who is the CEO of X?").
# - SEARCH: the grounded web-search call itself.
# - BACKGROUND: learning facts about you from the conversation.
# - BLENDER: 3D modelling jobs (a stronger model pays off here).
# JARVIS_AZURE_FAST_DEPLOYMENT=your-small-deployment
# JARVIS_AZURE_WEB_DEPLOYMENT=your-small-deployment
# JARVIS_AZURE_SEARCH_DEPLOYMENT=your-small-deployment
# JARVIS_AZURE_BACKGROUND_DEPLOYMENT=your-small-deployment
# JARVIS_AZURE_BLENDER_DEPLOYMENT=your-strong-deployment

# Keep the cached prompt alive for 24 h instead of minutes: the first request after
# a break reads the cache (~0.1x the input price) instead of re-storing it (1.25x).
# JARVIS_AZURE_CACHE_RETENTION=24h
# "responses" (default; one shared prompt cache) or "chat" (chat/completions).
# JARVIS_AZURE_API=responses

# ---------------------------------------------------------------- Gemini (free tier)
# Key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# JARVIS_CLOUD_MODEL=

# ---------------------------------------------------------------- Claude
# ANTHROPIC_API_KEY=
# JARVIS_CLAUDE_MODEL=

# ---------------------------------------------------------------- on-device model
# Needs `pip install -r requirements-local.txt` and about 16 GB of free memory.
# JARVIS_MODEL=mlx-community/gemma-4-26b-a4b-it-4bit

# ---------------------------------------------------------------- voice
# Off by default: the speech models cost 1-2 GB of memory.
# JARVIS_VOICE_ENABLED=1
# JARVIS_VOICE=af_heart
# JARVIS_STT=mlx-community/whisper-small.en-mlx

# ---------------------------------------------------------------- behaviour
# Where state lives (memory, journal, logs, usage ledger, socket). Default ~/.jarvis
# JARVIS_HOME=
# Folder that relative paths in requests resolve against. Default: your home.
# JARVIS_WORKSPACE=
# 0 = never answer from the built-in no-model shortcuts (time, battery, play/pause...).
# JARVIS_FASTPATH=1
# 0 = never route requests to the cheaper models.
# JARVIS_ROUTER=1
# 0 = do not learn facts about the user from the conversation.
# JARVIS_LEARNING=1
# 0 = never end an answer with a follow-up question.
# JARVIS_FOLLOWUPS=1
# instant = move the cursor in one jump instead of gliding.
# JARVIS_CURSOR=
# 0 = send no prompt_cache_key / retention parameters (an older API version).
# JARVIS_CACHE_PARAMS=1

# ---------------------------------------------------------------- development
# Point the tests at throwaway files (tests/_isolate.py does this for you):
# JARVIS_MEMORY_DB=/tmp/memory.sqlite3
# JARVIS_PROFILE_DB=/tmp/profile.sqlite3
# JARVIS_PREFS_DB=/tmp/prefs.sqlite3
# JARVIS_CLIPS_DB=/tmp/clips.sqlite3
# JARVIS_USAGE_LEDGER=/tmp/usage.jsonl
# 0 = skip the tests that call a real model.
# JARVIS_LIVE=1
# Code-signing identity for the companion app (companion/build.sh). Default: the
# first "Apple Development" identity in your keychain.
# JARVIS_SIGN_IDENTITY=
